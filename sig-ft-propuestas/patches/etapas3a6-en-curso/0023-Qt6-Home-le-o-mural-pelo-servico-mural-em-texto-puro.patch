+    monkeypatch.setattr(at, "mural", lambda linhas, hoje: recebidas.append((linhas, hoje)) or "GAVETAS")
+
+    gavetas, erro = ma.ler_mural_do_mapeamento("/x/mapeamento.xlsx", HOJE)
+
+    assert (gavetas, erro) == ("GAVETAS", None)
