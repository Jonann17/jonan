+def _geo(t, w):
+    p = w.mapTo(t, w.rect().topLeft())
+    return p.x(), p.y(), w.width(), w.height()
+
+
+def _perto(a, b, tol):
+    return all(abs(x - y) <= tol for x, y in zip(a, b))
+
