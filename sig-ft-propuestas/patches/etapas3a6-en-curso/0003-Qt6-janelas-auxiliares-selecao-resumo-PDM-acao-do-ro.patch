+def _geo(w, base):
+    p = w.mapTo(base, w.rect().topLeft())
+    return [p.x(), p.y(), w.width(), w.height()]
+
+
+def _mostrar(qtbot, j, largura, altura):
+    j.resize(largura, altura)
+    j.show()
+    qtbot.waitExposed(j)
+    QApplication.processEvents()
