+def test_fluxo_completo(tela, qtbot):
+    from sigft.app.textos_dialogos import MSG_LOGIN_LMR
+    tela.caminho_status_pmib = "/tmp/STATUS.xlsx"
+    tela.caixa_linha_inicial.setChecked(True)
+    tela.entry_linha_inicial.setText("7")
