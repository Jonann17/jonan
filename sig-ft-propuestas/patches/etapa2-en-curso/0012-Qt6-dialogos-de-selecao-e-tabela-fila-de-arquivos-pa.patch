+QTreeView QScrollBar::add-line, QTreeView QScrollBar::sub-line,
+QAbstractScrollArea[barra_nativa="true"] QScrollBar::add-line,
+QAbstractScrollArea[barra_nativa="true"] QScrollBar::sub-line {{
