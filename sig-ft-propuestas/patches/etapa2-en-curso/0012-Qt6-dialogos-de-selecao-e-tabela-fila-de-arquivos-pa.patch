+QRadioButton::indicator:hover {{ border-color: {AZUL_CTK_HOVER}; }}
+QSlider:horizontal {{ min-height: {ALTURA_SLIDER_CTK}px; max-height: {ALTURA_SLIDER_CTK}px;
