+++ b/tests/test_qt_main.py
@@ -105,3 +105,40 @@ def test_smoke_nao_pergunta_nada_mesmo_com_thread_comum_viva(qt_interface, monke
     finally:
         liberar.set()
         viva.join(3)
+
+
+def test_main_prepara_dados_e_navegador_antes_da_splash(qt_interface, monkeypatch, capsys):
+    """Mesmos passos de partida do app CustomTkinter, na mesma ordem."""
+    from sigft.core import dados_usuario, instancia
+    from sigft.core.rpa import navegador
+
+    eventos = []
+
+    class SplashFalsa:
+        pronta = type("S", (), {"connect": lambda self, f: eventos.append("conectou")})()
+
+        def __init__(self):
+            eventos.append("splash")
+
+        def show(self):
+            eventos.append("show")
+
+        def carregar(self):
+            eventos.append("carregar")
+
+    monkeypatch.setattr(instancia, "preparar", lambda: eventos.append("preparar"))
+    monkeypatch.setattr(instancia, "encerrar", lambda codigo=0: eventos.append(("encerrar", codigo)))
+    monkeypatch.setattr(dados_usuario, "migrar_se_preciso",
+                        lambda: eventos.append("migrou") or ["api_config.json"])
+    monkeypatch.setattr(navegador, "preparar_ambiente_do_rpa",
+                        lambda: eventos.append("navegador") or None)
+    monkeypatch.setattr(qmain, "_preparar_qt",
+                        lambda: type("A", (), {"exec": lambda self: eventos.append("exec")})())
+    monkeypatch.setattr(qmain, "SplashScreen", SplashFalsa)
+    qmain.main()
+    assert eventos.index("migrou") < eventos.index("splash")
+    assert eventos.index("navegador") < eventos.index("splash")
+    assert eventos[-1] == ("encerrar", 0)
+    saida = capsys.readouterr().out
+    assert "[SIG-FT] Configuracao importada para a pasta de dados: api_config.json" in saida
+    assert "[SIG-FT] Nenhum Chrome/Edge encontrado." in saida
diff --git a/tests/test_saida_log.py b/tests/test_saida_log.py
new file mode 100644
index 0000000..87b5f00
--- /dev/null
+++ b/tests/test_saida_log.py
@@ -0,0 +1,67 @@
+"""`sigft.core.saida_log`: sem console, o `print` do .exe vai para o sigft.log."""
+import sys
+
+from sigft.core import dados_usuario, saida_log
+
+
+def test_fora_do_exe_nao_mexe_em_nada(monkeypatch, tmp_path):
+    monkeypatch.delattr(sys, "frozen", raising=False)
+    monkeypatch.setattr(sys, "stdout", None)
+    monkeypatch.setattr(dados_usuario, "pasta_logs", lambda: tmp_path)
+    saida_log.desviar_saida_para_arquivo()
+    assert sys.stdout is None
+    assert not (tmp_path / "sigft.log").exists()
+
+
+def test_exe_com_console_nao_mexe_em_nada(monkeypatch, tmp_path):
+    monkeypatch.setattr(sys, "frozen", True, raising=False)
+    monkeypatch.setattr(dados_usuario, "pasta_logs", lambda: tmp_path)
+    antes = (sys.stdout, sys.stderr)
+    saida_log.desviar_saida_para_arquivo()
+    assert (sys.stdout, sys.stderr) == antes
+    assert not (tmp_path / "sigft.log").exists()
+
+
+def test_exe_sem_console_grava_no_log(monkeypatch, tmp_path):
+    monkeypatch.setattr(sys, "frozen", True, raising=False)
+    monkeypatch.setattr(sys, "stdout", None)
+    monkeypatch.setattr(sys, "stderr", None)
+    monkeypatch.setattr(dados_usuario, "pasta_logs", lambda: tmp_path)
+    saida_log.desviar_saida_para_arquivo()
+    try:
+        assert sys.stdout is not None and sys.stderr is sys.stdout
+        print("linha de teste")
+        sys.stdout.flush()
+    finally:
+        arquivo = sys.stdout
+        sys.stdout = sys.stderr = None  # o monkeypatch restaura depois
+        if arquivo is not None:
+            arquivo.close()
+    texto = (tmp_path / "sigft.log").read_text(encoding="utf-8")
+    assert "===== SIG-FT iniciado em" in texto
+    assert "linha de teste" in texto
+
+
+def test_nunca_levanta_se_nao_da_para_abrir_o_log(monkeypatch):
+    monkeypatch.setattr(sys, "frozen", True, raising=False)
+    monkeypatch.setattr(sys, "stdout", None)
+    monkeypatch.setattr(sys, "stderr", None)
+
+    def quebra():
+        raise OSError("disco cheio")
+
+    monkeypatch.setattr(dados_usuario, "pasta_logs", quebra)
+    saida_log.desviar_saida_para_arquivo()  # nao levanta
+    assert sys.stdout is None
+
+
+def test_modulo_nao_importa_interface():
+    import ast
+    from pathlib import Path
+
+    arvore = ast.parse(Path(saida_log.__file__).read_text(encoding="utf-8"))
+    nomes = {n.module if isinstance(n, ast.ImportFrom) else a.name
+             for n in ast.walk(arvore) if isinstance(n, (ast.Import, ast.ImportFrom))
+             for a in (n.names if isinstance(n, ast.Import) else [n])}
+    assert not any(n and n.split(".")[0] in {"tkinter", "customtkinter", "PySide6"}
+                   for n in nomes)
