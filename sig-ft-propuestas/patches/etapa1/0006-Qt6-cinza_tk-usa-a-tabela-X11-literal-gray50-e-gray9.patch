From 754deb9f0e5db9c519dfcc185002562d2d63dda0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 19:22:30 +0000
Subject: [PATCH 06/26] Qt6: cinza_tk usa a tabela X11 literal (gray50 e gray90
 arredondam para baixo)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RSbK7jX9qvsvyZKqnojmij
---
 sigft/app_qt/estilo.py  | 23 ++++++++++++++++++++---
 tests/test_qt_estilo.py | 21 +++++++++++++++++++++
 2 files changed, 41 insertions(+), 3 deletions(-)

diff --git a/sigft/app_qt/estilo.py b/sigft/app_qt/estilo.py
index b775bde..57351e8 100644
--- a/sigft/app_qt/estilo.py
+++ b/sigft/app_qt/estilo.py
@@ -23,15 +23,32 @@ ALTURA_BOTAO_BARRA = 40
 _SELETOR_TEXTO = "︎"
 
 
+# Nível (0-255) de "grayNN" no Tk, índice = NN. Vem da tabela X11 (rgb.txt), que NÃO
+# é uma fórmula de arredondamento (gray30 -> 77, mas gray50 -> 127): por isso a tabela
+# literal. Gerada uma vez; não ler rgb.txt em tempo de execução (não existe no Windows).
+_NIVEIS_CINZA_X11 = (
+    0, 3, 5, 8, 10, 13, 15, 18, 20, 23,
+    26, 28, 31, 33, 36, 38, 41, 43, 46, 48,
+    51, 54, 56, 59, 61, 64, 66, 69, 71, 74,
+    77, 79, 82, 84, 87, 89, 92, 94, 97, 99,
+    102, 105, 107, 110, 112, 115, 117, 120, 122, 125,
+    127, 130, 133, 135, 138, 140, 143, 145, 148, 150,
+    153, 156, 158, 161, 163, 166, 168, 171, 173, 176,
+    179, 181, 184, 186, 189, 191, 194, 196, 199, 201,
+    204, 207, 209, 212, 214, 217, 219, 222, 224, 227,
+    229, 232, 235, 237, 240, 242, 245, 247, 250, 252,
+    255,
+)
+
+
 def cinza_tk(nome: str) -> str:
     """`"grayNN"` do Tk em hexadecimal. O Qt não conhece esses nomes e pinta preto."""
     if nome in ("gray", "grey"):
         return "#BEBEBE"
     achado = re.fullmatch(r"gr[ae]y(\d{1,3})", nome)
-    if not achado:
+    if not achado or int(achado.group(1)) > 100:
         return nome
-    # Meio para cima, como o Tk (o round() do Python arredonda meio para o par).
-    valor = (255 * int(achado.group(1)) + 50) // 100
+    valor = _NIVEIS_CINZA_X11[int(achado.group(1))]
     return f"#{valor:02X}{valor:02X}{valor:02X}"
 
 
diff --git a/tests/test_qt_estilo.py b/tests/test_qt_estilo.py
index 553f242..efc9dbc 100644
--- a/tests/test_qt_estilo.py
+++ b/tests/test_qt_estilo.py
@@ -1,4 +1,7 @@
 import os
+import re
+
+import pytest
 
 from sigft.app import theme
 from sigft.app_qt import estilo
@@ -9,6 +12,24 @@ def test_cinza_tk_converte_como_o_tk():
     assert estilo.cinza_tk("gray30") == "#4D4D4D"
     assert estilo.cinza_tk("gray") == "#BEBEBE"
     assert estilo.cinza_tk("#123456") == "#123456"
+    assert estilo.cinza_tk("gray50") == "#7F7F7F"
+    assert estilo.cinza_tk("gray90") == "#E5E5E5"
+    assert estilo.cinza_tk("gray101") == "gray101"
+
+
+def test_cinza_tk_bate_com_a_tabela_x11_inteira():
+    caminho = "/usr/share/X11/rgb.txt"
+    if not os.path.isfile(caminho):
+        pytest.skip("rgb.txt do X11 não existe nesta máquina")
+    achados = {}
+    with open(caminho, encoding="utf-8", errors="replace") as arq:
+        for linha in arq:
+            m = re.fullmatch(r"\s*(\d+)\s+(\d+)\s+(\d+)\s+gr[ae]y(\d+)\s*", linha)
+            if m:
+                achados[int(m.group(4))] = int(m.group(1))
+    assert sorted(achados) == list(range(101))
+    for n, nivel in achados.items():
+        assert estilo.cinza_tk(f"gray{n}") == f"#{nivel:02X}{nivel:02X}{nivel:02X}", n
 
 
 def test_mono_pede_versao_texto_de_cada_emoji():
