From 252c065b37cc86f38aec15915fe6bde4d4866e10 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 19:33:19 +0000
Subject: [PATCH 09/12] Backends: falha de modulo com classes responde pelo
 nome da classe

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RSbK7jX9qvsvyZKqnojmij
---
 sigft/app/backends.py         |  3 +++
 tests/test_backends_falhas.py | 14 ++++++++++++++
 2 files changed, 17 insertions(+)

diff --git a/sigft/app/backends.py b/sigft/app/backends.py
index b4377a6..0fa0837 100644
--- a/sigft/app/backends.py
+++ b/sigft/app/backends.py
@@ -133,6 +133,9 @@ def carregar_todos(ao_progredir=None, ao_falhar=None, pausa_fn=None) -> None:
             carregar_um(nome_modulo, destino, classes)
         except Exception as erro:  # noqa: BLE001 — ver docstring
             falhas[destino] = erro
+            # As telas pedem o "mixed_classes" pelo nome da classe (DataManager...).
+            for nome_classe in classes or []:
+                falhas[nome_classe] = erro
             if ao_falhar is not None:
                 ao_falhar(exibido, erro)
 
diff --git a/tests/test_backends_falhas.py b/tests/test_backends_falhas.py
index ad1c48f..f748771 100644
--- a/tests/test_backends_falhas.py
+++ b/tests/test_backends_falhas.py
@@ -35,3 +35,17 @@ def test_exigir_sem_falha_registrada_ainda_explica(monkeypatch):
     monkeypatch.setattr(backends, "lmr_backend", None)
     with pytest.raises(backends.BackendIndisponivel, match="ainda não foi carregado"):
         backends.exigir("lmr_backend")
+
+
+def test_falha_de_modulo_com_classes_responde_pelo_nome_da_classe(monkeypatch):
+    """O Gerador de Fichas é `mixed_classes`: o módulo falha, mas as telas
+    pedem pelo nome da CLASSE (`DataManager`), não pelo destino."""
+    monkeypatch.setattr(backends, "MODULOS", [("modulo_que_nao_existe_y", "mixed_classes", ["DataManager"], "Teste")])
+    monkeypatch.setattr(backends, "DataManager", None)
+    ao_falhar_chamadas = []
+    backends.carregar_todos(ao_falhar=lambda nome, erro: ao_falhar_chamadas.append(nome))
+    assert len(ao_falhar_chamadas) == 1
+    with pytest.raises(backends.BackendIndisponivel) as erro:
+        backends.exigir("DataManager")
+    texto = str(erro.value)
+    assert "não carregou" in texto and "modulo_que_nao_existe_y" in texto
