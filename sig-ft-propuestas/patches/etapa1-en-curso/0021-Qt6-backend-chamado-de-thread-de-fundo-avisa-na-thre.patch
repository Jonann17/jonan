From feabd34c8748216c1dd59b3dfc8a5c67fbd68ed0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 20:36:39 +0000
Subject: [PATCH 21/26] Qt6: backend() chamado de thread de fundo avisa na
 thread da interface

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RSbK7jX9qvsvyZKqnojmij
---
 sigft/app_qt/widgets/module_frame.py | 14 ++++++++++++--
 tests/test_qt_module_frame.py        | 25 +++++++++++++++++++++++++
 2 files changed, 37 insertions(+), 2 deletions(-)

diff --git a/sigft/app_qt/widgets/module_frame.py b/sigft/app_qt/widgets/module_frame.py
index 6c374c5..d2b38d5 100644
--- a/sigft/app_qt/widgets/module_frame.py
+++ b/sigft/app_qt/widgets/module_frame.py
@@ -94,12 +94,22 @@ class ModuleFrame(DialogosDeEspera, QWidget):
             self.console.log(msg, nivel, contexto)
 
     def backend(self, nome: str):
-        """O backend `nome`, ou `None` depois de avisar a pessoa do porquê."""
+        """O backend `nome`, ou `None` depois de avisar a pessoa do porquê.
+
+        Pode ser chamado de uma thread de fundo: o aviso sempre aparece na
+        thread da interface.
+        """
         try:
             return backends.exigir(nome)
         except backends.BackendIndisponivel as erro:
             self.log(f"[ERRO] {erro}")
-            QMessageBox.warning(self, "Módulo indisponível", str(erro))
+            if interface.na_thread_da_interface():
+                QMessageBox.warning(self, "Módulo indisponível", str(erro))
+            else:
+                # As telas leem o backend dentro do worker; um QMessageBox criado
+                # fora da thread da interface derruba o app (macOS).
+                interface.na_interface(
+                    QMessageBox.warning, self, "Módulo indisponível", str(erro))
             return None
 
     def iniciar_tarefa(self, alvo, *args, botao=None) -> threading.Thread:
diff --git a/tests/test_qt_module_frame.py b/tests/test_qt_module_frame.py
index 94173c5..59cd541 100644
--- a/tests/test_qt_module_frame.py
+++ b/tests/test_qt_module_frame.py
@@ -68,3 +68,28 @@ def test_excecao_no_worker_vai_para_o_console_e_solta_o_botao(qt_interface, qtbo
     thread.join(3)
     qtbot.waitUntil(lambda: "ZeroDivisionError" in t.console.toPlainText(), timeout=2000)
     qtbot.waitUntil(botao.isEnabled, timeout=2000)
+
+
+def test_backend_pedido_de_thread_de_fundo_avisa_na_thread_da_interface(
+        qt_interface, qtbot, monkeypatch):
+    """As telas piloto leem o backend dentro do worker: o QMessageBox nao pode
+    nascer la (derruba o app no macOS) -- vai para a thread da interface."""
+    monkeypatch.setattr(backends, "lmr_backend", None)
+    monkeypatch.setattr(backends, "falhas", {"lmr_backend": ImportError("sem xlwings")})
+    chamadas = []
+    monkeypatch.setattr(
+        "sigft.app_qt.widgets.module_frame.QMessageBox.warning",
+        lambda *a, **k: chamadas.append((threading.get_ident(), a[2])))
+    t = Tela(titulo="x")
+    qtbot.addWidget(t)
+    resultado = []
+    worker = threading.Thread(
+        target=lambda: resultado.append(t.backend("lmr_backend")), daemon=True)
+    worker.start()
+    worker.join(3)
+    assert resultado == [None]                       # o worker nao trava nem recebe lixo
+    qtbot.waitUntil(lambda: len(chamadas) == 1, timeout=2000)
+    assert chamadas[0][0] == threading.get_ident()   # aviso na thread da interface
+    assert worker.ident != chamadas[0][0]
+    assert "sem xlwings" in chamadas[0][1]
+    qtbot.waitUntil(lambda: "sem xlwings" in t.console.toPlainText(), timeout=2000)
