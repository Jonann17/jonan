+class _AbaFalsa:
+    def __init__(self, linhas):
+        self.linhas = linhas
+        self.pedidos = []
+
+    def iter_rows(self, min_row=1, values_only=False):
+        self.pedidos.append((min_row, values_only))
+        return iter(self.linhas)
