+def test_catalogo_que_chega_depois_do_painel_sumir_nao_quebra(home, qtbot, rede):
+    janela = home.abrir_janela_modelos_ia()
+    liberar = threading.Event()
+    antigo = catalogo.listar_modelos
+
+    def lento(provider, chaves=None, *, forcar=False, **kw):
+        if forcar:
+            liberar.wait(5)
+        return antigo(provider, chaves, forcar=forcar, **kw)
+
+    import sigft.core.llm.catalogo as mod_catalogo
+    mod_catalogo.listar_modelos = lento
+    erros = []
+    try:
+        home.btn_atualizar_catalogo_ia.click()
+        janela.close()
+        janela.deleteLater()
+        qtbot.waitUntil(lambda: not _vivo(janela), timeout=2000)
+        antigo_excepthook = sys.excepthook
+        sys.excepthook = lambda *a: erros.append(a)
+        liberar.set()
+        qtbot.wait(200)
+        sys.excepthook = antigo_excepthook
+    finally:
+        mod_catalogo.listar_modelos = antigo
+    assert erros == []
+
