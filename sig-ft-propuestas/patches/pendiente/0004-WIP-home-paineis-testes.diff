+class _PastaFalsa:
+    def __init__(self, abas):
+        self.abas = abas
+        self.sheetnames = list(abas)
+        self.fechada = False
+
+    def __getitem__(self, nome):
+        return self.abas[nome]
+
+    def close(self):
+        self.fechada = True
+
