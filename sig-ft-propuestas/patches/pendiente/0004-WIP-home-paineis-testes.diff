+def _geo(widget, origem):
+    p = widget.mapTo(origem, widget.rect().topLeft())
+    return p.x(), p.y(), widget.width(), widget.height()
+
+
+def _exposta(qtbot, janela):
+    qtbot.waitExposed(janela)
+    qtbot.wait(20)
+    return janela
+
