+@pytest.fixture
+def com_folha(qt_interface):
+    anterior = qt_interface.styleSheet()
+    estilo.carregar_fontes()
+    qt_interface.setStyleSheet(estilo.folha_de_estilo())
+    yield
+    qt_interface.setStyleSheet(anterior)
